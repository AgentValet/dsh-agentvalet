{
  "name": "@agentvalet/dsh",
  "version": "0.1.0",
  "description": "Governed platform access for DeepSeek Harness — no credential on the machine",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "agentvalet",
    "ai-governance",
    "approvals"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgentValet/dsh-agentvalet.git"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "agentvalet-dsh-connect": "./bin/connect.mjs"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "bin/connect.mjs",
    "cordis.patch.yml",
    "AGENTS.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "harness": ">=0.1.0-rc.5 <0.2.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --project tsconfig.test.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && node scripts/no-secrets.mjs"
  },
  "dependencies": {
    "@agentvalet/client": "^0.1.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "js-yaml": "^5.3.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
